# Copy this file to .env and fill in real values. .env is gitignored.

# Supabase transaction pooler connection string (Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared secret checked on POST /internal/ingest/{source} (generate with: openssl rand -hex 32)
INGEST_SHARED_SECRET=

# AlienVault OTX API key (https://otx.alienvault.com/settings)
OTX_API_KEY=

# abuse.ch Auth-Key, covers URLhaus + ThreatFox (https://auth.abuse.ch/)
ABUSECH_AUTH_KEY=
